{
  "permissions": {
    "deny": [
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(gh pr merge*)",
      "Bash(git push*)",
      "Bash(gh workflow run*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)"
    ],
    "ask": [
      "Edit(.claude/settings.json)",
      "Edit(~/.claude/settings.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *.go) gofmt -w \"$f\" ;; esac; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
